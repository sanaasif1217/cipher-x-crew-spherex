{
 "query": {
  "archive": "ESA Gaia Archive TAP sync endpoint (gea.esac.esa.int/tap-server/tap/sync). ADQL written for astroquery.gaia; astroquery's TapPlus client cannot traverse this sandbox's HTTPS egress proxy (TLS WRONG_VERSION_NUMBER), so the identical query was POSTed with a proxy-aware requests session and the VOTable parsed with astropy.",
  "table": "gaiadr3.gaia_source",
  "adql": "SELECT source_id, ra, dec, phot_g_mean_mag, phot_bp_mean_mag, phot_rp_mean_mag, bp_rp, pmra, pmdec, parallax FROM gaiadr3.gaia_source WHERE CONTAINS(POINT('ICRS', ra, dec), CIRCLE('ICRS', 167.1309, 5.1732, 0.36)) = 1 AND phot_g_mean_mag IS NOT NULL ORDER BY phot_g_mean_mag ASC",
  "cone_centre_deg": [
   167.1309,
   5.1732
  ],
  "cone_radius_deg": 0.36,
  "rows_returned": 1272,
  "rows_inside_field": 751,
  "query_date_utc": "2026-11-13",
  "position_epoch_handling": "Gaia DR3 positions (epoch J2016.0) propagated to 2025-12-14 with catalogue pmra/pmdec before WCS mapping and nearest-neighbour tests; parallax neglected (<=0.05 arcsec).",
  "mapping": "RA/Dec -> native pixel via epoch-3 FITS celestial WCS (RA---TAN-SIP) using astropy world_to_pixel_values (0-based, x=column, y=array row, empirically identical to the stored cutout array indexing); PNG900 = native * (900/294, 900/293), the same scaling Phase 1 used. No flip or shift correction was needed (see validation)."
 },
